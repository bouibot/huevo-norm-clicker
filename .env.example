# Скопируй в .env и заполни: cp .env.example .env
BOT_TOKEN=123456:ABC-DEF...  # токен от @BotFather
OWNER_ID=123456789           # Telegram id владельца: создаёт коды приглашений, управляет админами
# Опционально:
# ADMIN_ID=123456789         # старый алиас OWNER_ID (если задан и OWNER_ID пуст - работает как OWNER_ID)
# HUE_BASE=https://huevo.su  # адрес сайта (обычно не трогаем)
# DATA_DIR=./data            # папка SQLite (data/clicker.db)
